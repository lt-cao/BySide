{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BySide",
  "version": "1.5.0",
  "identifier": "com.caole.byside",
  "build": {
    "beforeDevCommand": "npm run frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BySide",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#282828"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1421 https://api.github.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Cao Le",
    "copyright": "Copyright © 2026 Cao Le",
    "category": "Photography",
    "shortDescription": "Compare two images with synchronized zoom, pan and rulers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["Vietnamese", "English"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGQUIzRjM3RTkyQzQ0RDAKUldUUVJDenBOeityWHgzeFNBaTNmd0xJenFzSFZLQnZIT0MrQ2t4b3NRWFBSMDBxenJQei9xQTIK",
      "endpoints": [
        "https://github.com/lt-cao/BySide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
